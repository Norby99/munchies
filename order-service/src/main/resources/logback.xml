<configuration>
    <!-- Appender and root level come from micronaut-commons; LOG_FORMAT=json switches to
         structured output for log aggregation (see observability/README.md). -->
    <include resource="munchies-logback-${LOG_FORMAT:-text}.xml" />

    <logger name="org.apache.kafka" level="warn" />
    <logger name="io.micronaut.configuration.kafka" level="warn" />
    <logger name="org.mongodb.driver" level="warn" />
</configuration>
