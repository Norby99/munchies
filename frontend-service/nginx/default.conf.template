# Rendered at startup by the nginx entrypoint, which only replaces the variables defined in the
# environment: GATEWAY_URL and NGINX_LOCAL_RESOLVERS here, while nginx's own ones are left alone.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  location = /health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"UP"}';
  }

  # Same paths proxied by the Vite dev server. The address goes through a variable so that it is
  # resolved on each request: otherwise nginx would refuse to start until the gateway exists.
  location ~ ^/(users|restaurants|restaurant|orders|payments|schedule|reservations)(/|$) {
    set $gateway ${GATEWAY_URL};
    proxy_pass $gateway;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Live notifications: a WebSocket (Socket.io) to the gateway, which authenticates it with the
  # session cookie and proxies it to notification-service. The upgrade headers must be forwarded
  # explicitly, and the read timeout covers the idle time between Socket.io's heartbeats (25 s).
  location /notifications {
    set $gateway ${GATEWAY_URL};
    proxy_pass $gateway;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
  }

  # Client-side routes have no matching file, and are resolved by Vue Router.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
