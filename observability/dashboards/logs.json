{
  "title": "Munchies — Logs",
  "uid": "munchies-logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "textbox",
        "label": "Namespace (regex)",
        "current": {
          "text": ".+-service",
          "value": ".+-service"
        },
        "query": ".+-service"
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Contains",
        "current": {
          "text": "",
          "value": ""
        },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log lines by service",
      "description": "Lines per second written by each service matching the namespace filter.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (namespace) (rate({namespace=~\"$namespace\"}[$__auto]))",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warnings and errors by service",
      "description": "Lines per second logged at WARN or ERROR level.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (namespace, level) (rate({namespace=~\"$namespace\", level=~\"WARN|ERROR\"}[$__auto]))",
          "legendFormat": "{{ namespace }} {{ level }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Logs",
      "description": "Log lines of the selected services, newest first. Use the Contains box to search, e.g. for a request or trace id.",
      "type": "logs",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{namespace=~\"$namespace\"} |= `$search`",
          "refId": "A"
        }
      ]
    }
  ]
}
