# Port the scheduler HTTP server binds to
PORT=8080

# Downstream Micronaut services (internal cluster URLs, no trailing slash)
ORDER_SERVICE_URL=http://order-service:8080
RESTAURANT_SERVICE_URL=http://restaurant-service:8080

# How often (ms) the internal transition timer scans for orders due to start preparing
TRANSITION_TICK_MS=30000

# Fallback capacity policy used when restaurant-service does not (yet) expose
# GET /restaurants/{id}/capacity-policy
DEFAULT_SLOT_MINUTES=30
DEFAULT_MAX_CAPACITY_UNITS=8
DEFAULT_MAX_TRIPS_PER_SLOT=2
DEFAULT_MAX_TRIP_KM_BUDGET=15
DEFAULT_MAX_DETOUR_KM=1
# TEMPORARY until restaurant-service exposes coordinates: "lat,lng" of the restaurant
DEFAULT_OPENING=11:00
DEFAULT_CLOSING=22:00
DEFAULT_PREP_LEAD_MINUTES=30
DEFAULT_MAX_ADVANCE_DAYS=7

# TEMPORARY: the admission quota (kitchen units per slot) is drawn at random per restaurant in
# this range, until the CapacityAgent from analysis-scala decides it.
ADMISSION_QUOTA_MIN=5
ADMISSION_QUOTA_MAX=20
